<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/pestphp/pest/preset/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Filament/Resources/*/Pages</directory>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            DB de testing en PostgreSQL — algunos tests dependen de
            features específicas de Postgres (CTE recursivo, JSONB).
            Crear una DB dedicada antes de correr los tests:
                createdb sistema_altoque_test

            OJO: NO fijar acá DB_PORT ni DB_PASSWORD. Lo que se define en
            este archivo le gana al .env, y si el puerto de Postgres cambia
            (por ejemplo porque otro proyecto ya ocupaba el 5433) los tests
            quedan apuntando a la base equivocada y fallan con
            "password authentication failed". Dejándolos fuera, las pruebas
            usan el mismo host/puerto/clave que el resto del proyecto.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="sistema_altoque_test"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_CLIENT" value="predis"/>

        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="HORIZON_PATH" value="horizon"/>
    </php>
</phpunit>
